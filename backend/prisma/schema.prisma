generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum WhatsAppSessionStatus {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  CONNECTED
  ERROR
}

enum CampaignStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum CampaignContactStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  REPLIED
  FAILED
  SKIPPED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  passwordHash   String
  defaultCountry String   @default("PK")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions      WhatsAppSession[]
  contacts      Contact[]
  campaigns     Campaign[]
  importedFiles ImportedFile[]
  exportedFiles ExportedFile[]
  optOuts       OptOut[]
  activityLogs  ActivityLog[]
}

model WhatsAppSession {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                @db.ObjectId
  sessionName  String
  status       WhatsAppSessionStatus @default(DISCONNECTED)
  phoneNumber  String?
  connectedAt  DateTime?
  lastSeenAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([userId])
}

model Contact {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @db.ObjectId
  phoneNumber           String
  normalizedPhoneNumber String
  name                  String?
  email                 String?
  source                String?  @default("import")
  metadata              Json?
  isOptedOut            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignContacts CampaignContact[]
  replies          Reply[]

  @@unique([userId, normalizedPhoneNumber])
  @@index([userId])
  @@index([normalizedPhoneNumber])
}

model Campaign {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  userId            String         @db.ObjectId
  name              String
  messageTemplate   String
  whatsappSessionId String         @db.ObjectId
  status            CampaignStatus @default(DRAFT)
  totalContacts     Int            @default(0)
  pendingCount      Int            @default(0)
  sentCount         Int            @default(0)
  deliveredCount    Int            @default(0)
  repliedCount      Int            @default(0)
  failedCount       Int            @default(0)
  delayMin          Int            @default(3)
  delayMax          Int            @default(8)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappSession  WhatsAppSession   @relation(fields: [whatsappSessionId], references: [id])
  campaignContacts CampaignContact[]
  exportedFiles    ExportedFile[]
  activityLogs     ActivityLog[]

  @@index([userId])
  @@index([status])
}

model CampaignContact {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  campaignId         String                @db.ObjectId
  contactId          String                @db.ObjectId
  status             CampaignContactStatus @default(PENDING)
  personalizedMessage String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  repliedAt          DateTime?
  failureReason      String?
  isRead             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  replies  Reply[]

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@index([status])
}

model Message {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  campaignContactId String           @db.ObjectId
  whatsappMessageId String?
  direction         MessageDirection
  messageType       String           @default("text")
  content           String
  status            MessageStatus    @default(QUEUED)
  sentAt            DateTime?
  receivedAt        DateTime?
  createdAt         DateTime         @default(now())

  campaignContact CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  reply           Reply?

  @@index([campaignContactId])
  @@index([whatsappMessageId])
}

model Reply {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignContactId String   @db.ObjectId
  messageId         String?  @unique @db.ObjectId
  contactId         String   @db.ObjectId
  content           String
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  campaignContact CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  message         Message?        @relation(fields: [messageId], references: [id])
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignContactId])
  @@index([contactId])
}

model ImportedFile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  fileName         String
  originalFileName String
  fileType         String
  totalRows        Int      @default(0)
  validRows        Int      @default(0)
  invalidRows      Int      @default(0)
  columnMapping    Json?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExportedFile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  campaignId       String   @db.ObjectId
  fileName         String
  originalFileName String
  fileSize         Int?     @default(0)
  createdAt        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([campaignId])
}

model OptOut {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @db.ObjectId
  phoneNumber           String
  normalizedPhoneNumber String
  reason                String?  @default("user_request")
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedPhoneNumber])
  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  campaignId  String?  @db.ObjectId
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([campaignId])
}
